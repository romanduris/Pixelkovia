{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treasurequest-admin",
  "account_id": "SET_ONLY_AFTER_ACCOUNT_APPROVAL",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "ENVIRONMENT": "production",
    "DEMO_MODE": "false",
    "ACCESS_TEAM_DOMAIN": "SET_AFTER_APPROVED_ACCESS_ONBOARDING",
    "ACCESS_AUD": "SET_FROM_NEW_TREASUREQUEST_ACCESS_APP",
    "ADMIN_EMAILS": "SET_APPROVED_ADMIN_EMAIL",
    "WEB_URL": "https://zahada-u-vas-doma.alert-coin-6330.chatgpt.site"
  },
  "d1_databases": [{"binding": "TQ_DB", "database_name": "treasurequest-db", "database_id": "SET_ID_OF_NEW_APPROVED_DB_ONLY", "migrations_dir": "migrations"}],
  "env": {
    "preview": {
      "name": "treasurequest-admin-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {"ENVIRONMENT": "preview", "DEMO_MODE": "false", "ACCESS_TEAM_DOMAIN": "SET_TEAM_DOMAIN", "ACCESS_AUD": "SET_SEPARATE_PREVIEW_ACCESS_AUD", "ADMIN_EMAILS": "SET_APPROVED_ADMIN_EMAIL", "WEB_URL": "https://zahada-u-vas-doma.alert-coin-6330.chatgpt.site"},
      "d1_databases": [{"binding": "TQ_DB", "database_name": "treasurequest-db-preview", "database_id": "SET_ID_OF_NEW_APPROVED_PREVIEW_DB_ONLY", "migrations_dir": "migrations"}]
    }
  }
}
