{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treasurequest-admin",
  "account_id": "033ec39e1948bd5785d92d1993a8036f",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {"crons":["*/10 * * * *"]},
  "vars": {
    "ENVIRONMENT": "production",
    "DEMO_MODE": "false",
    "ADMIN_AUTH_MODE": "password",
    "WEB_URL": "https://pixelkovia.rodulab.com"
  },
  "d1_databases": [
    {
      "binding": "TQ_DB",
      "database_name": "treasurequest-db",
      "database_id": "a92475ad-b1e6-4a92-90dd-76e9b8e95b7a",
      "migrations_dir": "migrations"
    }
  ]
}
